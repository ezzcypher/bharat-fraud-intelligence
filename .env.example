# Placeholders only. The app reads these from the process environment (export them in your shell or set them in the
# launch cell); it does not load a .env file. Never commit a real .env.

# Folder that holds YOUR private artifact bundle (frozen model, Phase 4-8 outputs, licensed IEEE-CIS data).
# Without it, model pages show a clear "unavailable" state; complaints, cases and the synthetic pipeline still work.
BFI_ROOT=/path/to/private/artifact_bundle

# investigation (default, labels hidden) or evaluation (labels visible, for measuring the model only).
BFI9_MODE=investigation

# SQLite file for monitoring events, complaints and cases (local runtime state, git-ignored).
BFI9_OPS_DB=outputs/runtime/bfi_ops.sqlite

# Shared reviewer code for case status changes/notes in this single-user demo. Choose your own; not real authentication.
BFI9_REVIEWER_CODE=replace-with-your-own-code

# Optional: enables SEC feeds on the Global Fraud Intelligence page (SEC requires a declared User-Agent with contact).
BFI9_SEC_USER_AGENT="Your Name your.email@example.com"
